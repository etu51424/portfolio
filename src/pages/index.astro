---
import Layout from '../layouts/Layout.astro';
import Thumbnail from '../components/Thumbnail.astro';
import {getCollection} from 'astro:content';
import {tagUrl} from '../lib/tag-search.mjs';
const notes=await getCollection('notes');
---
<Layout active="home"><main class="feed"><div class="media-grid">{notes.map(note=>{
const minutes=Math.max(1,Math.ceil((note.body||'').split(/\s+/).length/200));
return <article class="media-card" data-domain={note.data.domain}><div class="thumbnail"><a class="thumbnail-link" href={'/notes/'+note.id+'/'} aria-label={note.data.title}>{note.data.thumbnail?<img src={note.data.thumbnail} alt="" loading="lazy"/>:<Thumbnail domain={note.data.domain}/>}<span class="duration">{note.data.video?(note.data.duration||'Vidéo'):minutes+' min de lecture'}</span>{note.data.video&&<span class="play" aria-hidden="true">▶</span>}</a>{note.data.thumbnailTags.length>0&&<div class="thumbnail-tags note-tags">{note.data.thumbnailTags.map(tag=><a href={tagUrl(tag)}>#{tag}</a>)}</div>}</div><div class="card-info"><h2><a href={'/notes/'+note.id+'/'}>{note.data.title}</a></h2></div></article>;
})}</div></main></Layout>
<script>
const domain=new URLSearchParams(location.search).get('domain')||'';
const tabs=Array.from(document.querySelectorAll<HTMLAnchorElement>('.feed-tabs a'));
const valid=tabs.some(tab=>tab.dataset.domain===domain);
const selected=valid?domain:'';
for(const tab of tabs){if(tab.dataset.domain===selected)tab.setAttribute('aria-current','page');else tab.removeAttribute('aria-current');}
for(const card of document.querySelectorAll<HTMLElement>('.media-card'))card.hidden=!!selected&&card.dataset.domain!==selected;
</script>
